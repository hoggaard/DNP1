@inherits LayoutComponentBase

<div class="flex flex-col md:flex-row min-h-screen bg-gray-50 text-gray-900 font-sans">
    <aside class="w-full md:w-64 md:min-h-screen bg-gray-900 border-r border-gray-800 shrink-0">
        <NavMenu />
    </aside>

    <div class="flex-1 flex flex-col min-w-0">
        @* <header class="h-16 bg-white border-b border-gray-200 flex items-center justify-end px-6 shadow-xs sticky top-0 z-10"> *@
        @*     <a href="https://learn.microsoft.com/aspnet/core/"  *@
        @*        target="_blank"  *@
        @*        class="text-sm font-medium text-gray-600 hover:text-blue-600 transition-colors"> *@
        @*         About *@
        @*     </a> *@
        @* </header> *@

        <main class="flex-1 p-6 md:p-8 max-w-7xl w-full mx-auto">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" 
     data-nosnippet 
     class="hidden fixed bottom-4 right-4 z-50 max-w-md bg-amber-50 border border-amber-200 text-amber-900 px-4 py-3 rounded-xl shadow-lg flex items-center justify-between gap-3 text-sm">
    <div class="flex items-center gap-2">
        <span class="text-amber-600 text-lg">⚠️</span>
        <span>An unhandled error has occurred.</span>
        <a href="." class="reload font-semibold text-amber-700 underline hover:text-amber-800">Reload</a>
    </div>
    <button type="button" class="dismiss text-amber-600 hover:text-amber-900 font-bold px-2 py-0.5 rounded cursor-pointer">
        ✕
    </button>
</div>