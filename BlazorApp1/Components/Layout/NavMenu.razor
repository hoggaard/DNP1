@using BlazorApp1.Auth
@using Microsoft.AspNetCore.Components.Authorization
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthProvider

<div class="flex items-center justify-between h-16 px-4 bg-gray-900 text-white md:justify-start">
    <a class="text-lg font-bold tracking-tight text-white hover:text-gray-200 transition-colors" href="">
        Post Stupid Stuff
    </a>
    
    <button type="button" 
            class="p-2 text-gray-400 hover:text-white hover:bg-gray-800 rounded-lg md:hidden transition-colors"
            @onclick="ToggleNavMenu" 
            aria-label="Toggle navigation">
        <span class="ti ti-menu-2 text-xl block"></span>
    </button>
</div>

<div class="@NavMenuCssClass md:block bg-gray-900 h-full overflow-y-auto" @onclick="CollapseNavMenu">
    <nav class="flex flex-col gap-1 p-3">
        <div>
            <NavLink class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium text-gray-300 rounded-lg hover:bg-gray-800 hover:text-white transition-colors"
                     href="" 
                     Match="NavLinkMatch.All">
                <span class="ti ti-home text-lg text-gray-400" aria-hidden="true"></span>
                <span>Home</span>
            </NavLink>
        </div>
        
        <div>
            <NavLink class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium text-gray-300 rounded-lg hover:bg-gray-800 hover:text-white transition-colors"
                     href="AddUser">
                <span class="ti ti-user-plus text-lg text-gray-400" aria-hidden="true"></span>
                <span>Add User</span>
            </NavLink>
        </div>
        
        <div>
            <NavLink class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium text-gray-300 rounded-lg hover:bg-gray-800 hover:text-white transition-colors"
                     href="CreatePost">
                <span class="ti ti-note text-lg text-gray-400" aria-hidden="true"></span>
                <span>Create Post</span>
            </NavLink>
        </div>
        <AuthorizeView>
            <Authorized>
                <div>
                    <NavLink class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium text-gray-300 rounded-lg hover:bg-gray-800 hover:text-white transition-colors cursor-pointer" @onclick="Logout">
                        <span class="ti ti-logout text-lg text-gray-400" aria-hidden="true"></span>
                        <span>Logout</span>
                    </NavLink>
                </div>
            </Authorized>
            <NotAuthorized>
                <div>
                    <NavLink class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium text-gray-300 rounded-lg hover:bg-gray-800 hover:text-white transition-colors"
                             href="Login">
                        <span class="ti ti-login text-lg text-gray-400" aria-hidden="true"></span>
                        <span>Login</span>
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string NavMenuCssClass => collapseNavMenu ? "hidden" : "block";

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void CollapseNavMenu()
    {
        collapseNavMenu = true;
    }

    private async Task Logout()
    {
        await ((SimpleAuthProvider)AuthProvider).LogoutAsync();
    }
}